/* pages/station/index.wxss */
.page { padding: 20rpx; padding-bottom: 160rpx; }

.station-header { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; }
.station-title-row { display: flex; align-items: center; gap: 12rpx; margin-bottom: 12rpx; }
.brand-badge { background: #E6F0FF; color: #1677FF; padding: 4rpx 12rpx; border-radius: 4rpx; font-size: 22rpx; }
.station-name { font-size: 32rpx; font-weight: bold; }
.station-address { display: flex; align-items: center; gap: 8rpx; font-size: 26rpx; color: #666; }

.status-card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; }
.status-title { font-size: 28rpx; font-weight: bold; margin-bottom: 20rpx; }
.port-grid { display: flex; gap: 24rpx; margin-bottom: 16rpx; }
.port-item { flex: 1; display: flex; flex-direction: column; align-items: center; }
.port-num { font-size: 48rpx; font-weight: bold; }
.port-label { font-size: 22rpx; color: #999; }
.port-item.free .port-num { color: #52C41A; }
.port-item.occupied .port-num { color: #FAAD14; }
.port-item.fault .port-num { color: #FF4D4F; }
.port-item.total .port-num { color: #1677FF; }
.status-bar { height: 8rpx; background: #f0f0f0; border-radius: 4rpx; overflow: hidden; }
.status-bar-fill { height: 100%; background: #52C41A; border-radius: 4rpx; transition: width 0.3s; }

.price-card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; }
.price-main { display: flex; align-items: baseline; gap: 8rpx; margin-bottom: 12rpx; }
.price-value { font-size: 48rpx; font-weight: bold; color: #FF4D4F; }
.price-unit { font-size: 24rpx; color: #999; }
.price-tags { display: flex; flex-wrap: wrap; gap: 8rpx; }

.tabs { display: flex; background: #fff; border-radius: 12rpx; padding: 8rpx; margin-bottom: 20rpx; }
.tab { flex: 1; text-align: center; padding: 16rpx; font-size: 28rpx; color: #666; border-radius: 8rpx; }
.tab.active { background: #1677FF; color: #fff; }

.tab-content { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; }
.info-row { display: flex; justify-content: space-between; padding: 16rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.info-label { color: #999; }
.info-value { color: #333; }

.review-item { padding: 20rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.review-header { display: flex; justify-content: space-between; margin-bottom: 8rpx; }
.reviewer { font-weight: bold; }
.star { color: #ddd; }
.star.filled { color: #FAAD14; }
.review-content { font-size: 28rpx; color: #333; margin-bottom: 8rpx; }
.review-time { font-size: 22rpx; }

.record-item { display: flex; justify-content: space-between; padding: 16rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.record-time { font-size: 26rpx; color: #333; }
.record-duration { font-size: 22rpx; color: #999; margin-top: 4rpx; }
.record-cost { font-size: 30rpx; font-weight: bold; color: #FF4D4F; }

.bottom-bar { position: fixed; bottom: 0; left: 0; right: 0; display: flex; gap: 20rpx; padding: 20rpx; background: #fff; box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06); }
.bar-btn { flex: 1; padding: 24rpx; border-radius: 8rpx; text-align: center; font-size: 28rpx; }
.bar-btn.navigate { background: #E6F0FF; color: #1677FF; }
.bar-btn.charge { background: #1677FF; color: #fff; }

.charge-popup { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 100; }
.popup-mask { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); }
.popup-content { position: absolute; bottom: 0; left: 0; right: 0; background: #fff; border-radius: 24rpx 24rpx 0 0; padding: 32rpx; }
.popup-title { font-size: 32rpx; font-weight: bold; text-align: center; margin-bottom: 24rpx; }
.port-select { display: flex; flex-wrap: wrap; gap: 16rpx; margin-bottom: 24rpx; }
.port-option { padding: 16rpx 24rpx; background: #f5f5f5; border-radius: 8rpx; font-size: 26rpx; }
.port-option.selected { background: #E6F0FF; color: #1677FF; border: 2rpx solid #1677FF; }
.charge-modes { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.mode-btn { flex: 1; padding: 16rpx; text-align: center; background: #f5f5f5; border-radius: 8rpx; font-size: 26rpx; }
.mode-btn.active { background: #1677FF; color: #fff; }
.charge-input { margin-bottom: 24rpx; }
.input-value { display: block; text-align: center; font-size: 28rpx; color: #1677FF; margin-top: 8rpx; }
.popup-actions { display: flex; gap: 24rpx; }
.popup-btn { flex: 1; padding: 24rpx; border-radius: 8rpx; text-align: center; font-size: 28rpx; }
.popup-btn.cancel { background: #f5f5f5; color: #666; }
.popup-btn.confirm { background: #1677FF; color: #fff; }
.popup-btn.confirm.disabled { background: #ccc; }

.loading { display: flex; align-items: center; justify-content: center; padding: 100rpx; }
