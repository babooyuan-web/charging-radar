/* pages/scan/index.wxss */
.page { padding: 20rpx; padding-bottom: 160rpx; }

.scan-section { display: flex; flex-direction: column; align-items: center; padding: 80rpx 40rpx; }
.scan-icon { font-size: 120rpx; margin-bottom: 20rpx; }
.scan-title { font-size: 32rpx; font-weight: bold; margin-bottom: 12rpx; }
.scan-desc { font-size: 26rpx; color: #999; margin-bottom: 40rpx; text-align: center; }

.station-info { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; }
.info-header { display: flex; align-items: center; gap: 12rpx; margin-bottom: 16rpx; }
.name { font-size: 30rpx; font-weight: bold; }
.info-row { display: flex; justify-content: space-between; padding: 12rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.label { font-size: 26rpx; color: #999; }
.value { font-size: 26rpx; color: #333; }

.port-section { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; }
.section-title { font-size: 28rpx; font-weight: bold; margin-bottom: 16rpx; }
.port-list { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16rpx; }
.port-item { display: flex; flex-direction: column; align-items: center; padding: 16rpx; border: 2rpx solid #f0f0f0; border-radius: 8rpx; }
.port-item.available { border-color: #52C41A; }
.port-item.occupied { border-color: #ccc; opacity: 0.5; }
.port-item.selected { border-color: #1677FF; background: #E6F0FF; }
.port-num { font-size: 32rpx; font-weight: bold; }
.port-status { font-size: 20rpx; color: #999; }

.mode-section { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; }
.mode-list { display: flex; gap: 16rpx; margin-bottom: 20rpx; }
.mode-item { flex: 1; padding: 16rpx; text-align: center; background: #f5f5f5; border-radius: 8rpx; font-size: 28rpx; }
.mode-item.active { background: #1677FF; color: #fff; }
.time-slider { margin-top: 16rpx; }
.slider-value { display: block; text-align: center; font-size: 28rpx; color: #1677FF; margin-top: 8rpx; }

.start-section { position: fixed; bottom: 0; left: 0; right: 0; padding: 20rpx; background: #fff; box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06); }

.btn-primary.disabled { background: #ccc; }
