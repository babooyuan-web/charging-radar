/* pages/me/index.wxss */
.page { padding: 20rpx; padding-bottom: 40rpx; }

.user-card { background: linear-gradient(135deg, #1677FF, #69B1FF); border-radius: 20rpx; padding: 32rpx; margin-bottom: 20rpx; }
.user-info { display: flex; align-items: center; gap: 20rpx; margin-bottom: 20rpx; }
.avatar { width: 80rpx; height: 80rpx; border-radius: 50%; }
.nickname { font-size: 32rpx; font-weight: bold; color: #fff; }
.user-type { font-size: 24rpx; color: rgba(255,255,255,0.8); }
.balance-row { display: flex; justify-content: space-between; padding-top: 20rpx; border-top: 1rpx solid rgba(255,255,255,0.2); }
.balance-label { font-size: 26rpx; color: rgba(255,255,255,0.8); }
.balance-value { font-size: 36rpx; font-weight: bold; color: #fff; }

.stats-card { display: flex; background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; }
.stat-item { flex: 1; display: flex; flex-direction: column; align-items: center; }
.stat-num { font-size: 32rpx; font-weight: bold; color: #1677FF; }
.stat-label { font-size: 22rpx; color: #999; margin-top: 4rpx; }

.menu-list { background: #fff; border-radius: 16rpx; margin-bottom: 20rpx; }
.menu-item { display: flex; align-items: center; padding: 24rpx; border-bottom: 1rpx solid #f5f5f5; }
.menu-item:last-child { border-bottom: none; }
.menu-icon { font-size: 36rpx; margin-right: 16rpx; }
.menu-title { flex: 1; font-size: 28rpx; }
.menu-arrow { font-size: 24rpx; color: #ccc; }

.logout-section { margin-top: 40rpx; }
.logout-btn { padding: 24rpx; text-align: center; color: #FF4D4F; font-size: 28rpx; background: #fff; border-radius: 12rpx; }
