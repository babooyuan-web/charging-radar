<!-- pages/me/index.wxml -->
<view class="page">
  <!-- 用户信息卡片 -->
  <view class="user-card">
    <view class="user-info">
      <image class="avatar" src="{{userInfo.avatarUrl || '/static/icons/default-avatar.png'}}" />
      <view class="user-meta">
        <text class="nickname">{{userInfo.nickname || '用户'}}</text>
        <text class="user-type">{{userInfo.userType == 'rider' ? '骑手' : userInfo.userType == 'courier' ? '快递员' : '用户'}}</text>
      </view>
    </view>
    <view class="balance-row">
      <text class="balance-label">余额</text>
      <text class="balance-value">¥{{userInfo.balance || '0.00'}}</text>
    </view>
  </view>

  <!-- 充电统计 -->
  <view class="stats-card">
    <view class="stat-item">
      <text class="stat-num">{{stats.orderCount}}</text>
      <text class="stat-label">充电次数</text>
    </view>
    <view class="stat-item">
      <text class="stat-num">{{stats.totalPower}}</text>
      <text class="stat-label">充电量(kWh)</text>
    </view>
    <view class="stat-item">
      <text class="stat-num">¥{{stats.totalCost}}</text>
      <text class="stat-label">总花费</text>
    </view>
    <view class="stat-item">
      <text class="stat-num">{{stats.carbonSaved}}</text>
      <text class="stat-label">减碳(kg)</text>
    </view>
  </view>

  <!-- 菜单 -->
  <view class="menu-list">
    <view class="menu-item" wx:for="{{menuItems}}" wx:key="title" bindtap="onMenuTap" data-url="{{item.url}}" data-tab="{{item.tab}}" data-key="{{item.key}}">
      <text class="menu-icon">{{item.icon}}</text>
      <text class="menu-title">{{item.title}}</text>
      <text class="menu-arrow">></text>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-section">
    <view class="logout-btn" bindtap="logout">退出登录</view>
  </view>
</view>
