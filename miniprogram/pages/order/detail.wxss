/* pages/order/detail.wxss */
.page { padding: 20rpx; padding-bottom: 160rpx; }

.status-section { display: flex; flex-direction: column; align-items: center; padding: 60rpx 40rpx; }
.status-icon { width: 120rpx; height: 120rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-bottom: 20rpx; }
.status-icon.charging { background: #E6F0FF; }
.status-icon.completed { background: #E6F7E6; }
.status-icon.pending { background: #FFF7E6; }
.status-icon { background: #FFF1F0; }
.status-icon .icon { font-size: 60rpx; }
.status-title { font-size: 36rpx; font-weight: bold; margin-bottom: 8rpx; }
.status-desc { font-size: 26rpx; color: #999; }

.station-section { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; }
.station-info { display: flex; align-items: center; gap: 12rpx; margin-bottom: 8rpx; }
.station-name { font-size: 30rpx; font-weight: bold; }
.station-address { font-size: 26rpx; }

.data-section { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; }
.data-title { font-size: 28rpx; font-weight: bold; margin-bottom: 20rpx; }
.data-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24rpx; }
.data-cell { display: flex; flex-direction: column; align-items: center; }
.data-num { font-size: 40rpx; font-weight: bold; color: #1677FF; }
.data-label { font-size: 24rpx; color: #999; margin-top: 4rpx; }

.time-section { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; }
.time-item { display: flex; justify-content: space-between; padding: 12rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.time-label { font-size: 26rpx; color: #999; }
.time-value { font-size: 26rpx; color: #333; }

.pay-section { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; }
.pay-row { display: flex; justify-content: space-between; padding: 12rpx 0; }
.pay-label { font-size: 26rpx; color: #999; }
.pay-value { font-size: 26rpx; color: #333; }

.action-section { display: flex; gap: 20rpx; position: fixed; bottom: 0; left: 0; right: 0; padding: 20rpx; background: #fff; box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06); }
.action-btn { flex: 1; padding: 24rpx; text-align: center; border-radius: 8rpx; font-size: 28rpx; background: #f5f5f5; color: #666; }
.action-btn.primary { background: #1677FF; color: #fff; }
