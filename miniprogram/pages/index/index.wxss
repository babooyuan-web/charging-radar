/* pages/index/index.wxss - 雷达首页样式 */
.page {
  padding: 20rpx;
  padding-bottom: 160rpx;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.search-input {
  flex: 1;
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08);
}

.search-input input {
  flex: 1;
  margin-left: 12rpx;
  font-size: 28rpx;
}

.icon-search {
  font-size: 32rpx;
}

.filter-btn {
  width: 64rpx;
  height: 64rpx;
  background: #1677FF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(22,119,255,0.3);
}

/* 雷达区 */
.radar-area {
  position: relative;
  height: 400rpx;
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.radar-container {
  position: relative;
  width: 300rpx;
  height: 300rpx;
}

.radar-circle {
  position: absolute;
  border-radius: 50%;
  border: 2rpx solid rgba(22,119,255,0.2);
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.radar-circle-1 {
  width: 100rpx;
  height: 100rpx;
  animation: radar-pulse 2s infinite;
}

.radar-circle-2 {
  width: 200rpx;
  height: 200rpx;
  animation: radar-pulse 2s infinite 0.5s;
}

.radar-circle-3 {
  width: 300rpx;
  height: 300rpx;
  animation: radar-pulse 2s infinite 1s;
}

.radar-scan-line {
  position: absolute;
  width: 2rpx;
  height: 150rpx;
  background: linear-gradient(to bottom, #1677FF, transparent);
  top: 50%;
  left: 50%;
  transform-origin: 50% 100%;
  animation: radar-spin 4s linear infinite;
}

.radar-center {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80rpx;
  height: 80rpx;
  background: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.1);
}

.radar-icon {
  font-size: 40rpx;
}

.scan-result {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-top: 20rpx;
}

.scan-result-num {
  font-size: 72rpx;
  font-weight: bold;
  color: #1677FF;
}

.scan-result-label {
  font-size: 28rpx;
  color: #999;
}

.free-hint {
  margin-top: 16rpx;
}

.free-hint-text {
  font-size: 24rpx;
  color: #52C41A;
  background: #E6F7E6;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

.rescan-btn {
  margin-top: 20rpx;
  padding: 12rpx 32rpx;
  background: #f0f0f0;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #666;
}

/* 范围切换 */
.radius-bar {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  padding: 8rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.radius-item {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  font-size: 26rpx;
  color: #666;
  border-radius: 8rpx;
  transition: all 0.2s;
}

.radius-item.active {
  background: #1677FF;
  color: #fff;
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  align-items: center;
  gap: 32rpx;
  margin-bottom: 20rpx;
  padding: 0 8rpx;
}

.filter-item {
  font-size: 28rpx;
  color: #666;
  padding: 8rpx 16rpx;
}

.filter-item.active {
  color: #1677FF;
  font-weight: bold;
}

.filter-toggle {
  margin-left: auto;
  font-size: 26rpx;
  color: #1677FF;
}

/* 地图 */
.map-container {
  margin-bottom: 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.08);
}

/* 充电桩列表 */
.station-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  /* 给悬浮扫码按钮留出安全距离，最后一张卡不会被挡住 */
  padding-bottom: 260rpx;
}

.station-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.station-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.station-brand {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.brand-logo {
  font-size: 40rpx;
}

.station-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.station-distance {
  background: #f5f5f5;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

.distance-text {
  font-size: 22rpx;
  color: #999;
}

/* 状态 */
.station-status {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.port-status {
  display: flex;
  gap: 24rpx;
}

.port-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.port-num {
  font-size: 36rpx;
  font-weight: bold;
}

.port-label {
  font-size: 20rpx;
  color: #999;
  margin-top: 4rpx;
}

.port-item.free .port-num {
  color: #52C41A;
}

.port-item.occupied .port-num {
  color: #FAAD14;
}

.port-item.total .port-num {
  color: #1677FF;
}

.price-tag {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.price-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #FF4D4F;
}

.price-unit {
  font-size: 22rpx;
  color: #999;
}

/* 标签 */
.station-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

/* 操作 */
.station-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  flex: 1;
  padding: 16rpx;
  border-radius: 8rpx;
  text-align: center;
  font-size: 26rpx;
}

.action-btn.navigate {
  background: #E6F0FF;
  color: #1677FF;
}

.action-btn.charge {
  background: #1677FF;
  color: #fff;
}

/* 扫码按钮（紧凑圆形悬浮球） */
.scan-fab {
  position: fixed;
  right: 28rpx;
  bottom: 168rpx;
  z-index: 30;
  width: 116rpx;
  height: 116rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #1677FF 0%, #4096FF 100%);
  color: #fff;
  border-radius: 50%;
  box-shadow: 0 6rpx 20rpx rgba(22, 119, 255, 0.4);
}

.scan-fab:active {
  transform: scale(0.94);
  box-shadow: 0 2rpx 10rpx rgba(22, 119, 255, 0.35);
}

.fab-icon {
  font-size: 40rpx;
  line-height: 1;
}

.fab-text {
  font-size: 18rpx;
  line-height: 1;
  margin-top: 6rpx;
}

/* 筛选弹窗 */
.filter-popup {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
}

.filter-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
}

.filter-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx;
  max-height: 70vh;
}

.filter-title {
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 32rpx;
}

.filter-section {
  margin-bottom: 32rpx;
}

.filter-section-title {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.filter-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.filter-option {
  padding: 12rpx 24rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #666;
}

.filter-option.active {
  background: #E6F0FF;
  color: #1677FF;
  font-weight: bold;
}

.filter-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 40rpx;
}

.filter-btn-reset, .filter-btn-apply {
  flex: 1;
  padding: 24rpx;
  border-radius: 8rpx;
  text-align: center;
  font-size: 28rpx;
}

.filter-btn-reset {
  background: #f5f5f5;
  color: #666;
}

.filter-btn-apply {
  background: #1677FF;
  color: #fff;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
  color: #999;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
  opacity: 0.3;
}

.empty-text {
  font-size: 30rpx;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 24rpx;
}

/* 离线演示模式提示条 */
.offline-tip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin: 0 24rpx 16rpx;
  padding: 16rpx 24rpx;
  background: #FFF7E6;
  border: 1rpx solid #FFE0A3;
  border-radius: 16rpx;
}

.offline-tip-icon {
  font-size: 28rpx;
}

.offline-tip-text {
  font-size: 24rpx;
  color: #AD6800;
  line-height: 1.4;
}
