/* pages/login/index.wxss */
.page { padding: 40rpx; min-height: 100vh; background: linear-gradient(180deg, #1677FF 0%, #f5f5f5 60%); }

.brand-section { display: flex; flex-direction: column; align-items: center; padding: 80rpx 0; }
.brand-icon { font-size: 100rpx; margin-bottom: 20rpx; }
.brand-name { font-size: 40rpx; font-weight: bold; color: #fff; margin-bottom: 8rpx; }
.brand-desc { font-size: 26rpx; color: rgba(255,255,255,0.8); }

.user-type-section { background: #fff; border-radius: 24rpx; padding: 32rpx; margin-bottom: 40rpx; }
.section-title { font-size: 30rpx; font-weight: bold; margin-bottom: 24rpx; display: block; text-align: center; }
.type-list { display: flex; flex-direction: column; gap: 20rpx; }
.type-item { display: flex; align-items: center; gap: 20rpx; padding: 24rpx; background: #f5f5f5; border-radius: 12rpx; }
.type-icon { font-size: 48rpx; }
.type-name { font-size: 30rpx; font-weight: bold; }
.type-desc { font-size: 24rpx; color: #999; margin-left: auto; }

/* 头像 + 昵称填写（替代已废弃的 wx.getUserProfile） */
.profile-section { background: #fff; border-radius: 24rpx; padding: 40rpx 32rpx; margin-bottom: 32rpx; display: flex; flex-direction: column; align-items: center; }
.avatar-btn { width: 160rpx; height: 160rpx; padding: 0; border-radius: 50%; background: transparent; display: flex; flex-direction: column; align-items: center; line-height: 1.2; }
.avatar-btn::after { border: none; }
.avatar-btn .avatar { width: 140rpx; height: 140rpx; border-radius: 50%; background: #e6e9ef; }
.avatar-btn .avatar-tip { margin-top: 12rpx; font-size: 24rpx; color: #999; }
.nickname-input { width: 100%; margin-top: 32rpx; height: 88rpx; padding: 0 24rpx; box-sizing: border-box; background: #f5f7fa; border-radius: 12rpx; font-size: 30rpx; color: #333; }

.login-actions { margin-bottom: 40rpx; }
.login-btn { width: 100%; padding: 24rpx; border-radius: 8rpx; font-size: 30rpx; border: none; }
.login-btn.primary { background: #1677FF; color: #fff; }
.login-btn { background: #fff; color: #333; }

.agreement-section { text-align: center; font-size: 24rpx; color: #999; }
.agreement-link { color: #1677FF; }
